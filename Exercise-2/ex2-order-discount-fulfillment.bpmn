  <bpmn:process id="Process_0d6fkau" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Start Order">
      <bpmn:outgoing>Flow_0be3v0k</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="Flow_0be3v0k" sourceRef="StartEvent_1" targetRef="Activity_0tfqr5x" />
    <bpmn:businessRuleTask id="Activity_0tfqr5x" name="Calculate Total Discount">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="calculate-discounts" resultVariable="totalDiscount" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0be3v0k</bpmn:incoming>
      <bpmn:outgoing>Flow_1j0kyhi</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_1j0kyhi" sourceRef="Activity_0tfqr5x" targetRef="Activity_0x0gg2d" />
    <bpmn:scriptTask id="Activity_0x0gg2d" name="Calculate Final Amount">
      <bpmn:extensionElements>
        <zeebe:script expression="=cartValue * (1 - (totalDiscount / 100))" resultVariable="finalAmount" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1j0kyhi</bpmn:incoming>
      <bpmn:outgoing>Flow_0nu0hkj</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:exclusiveGateway id="Gateway_09ftulc" name="Final Amount &#62;= 1000?">
      <bpmn:incoming>Flow_0nu0hkj</bpmn:incoming>
      <bpmn:outgoing>Flow_1aohbwy</bpmn:outgoing>
      <bpmn:outgoing>Flow_0qf5b9b</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_0nu0hkj" sourceRef="Activity_0x0gg2d" targetRef="Gateway_09ftulc" />
    <bpmn:task id="Activity_1scob0v" name="Manager Sign-off">
      <bpmn:incoming>Flow_1aohbwy</bpmn:incoming>
      <bpmn:outgoing>Flow_0lfv08m</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1aohbwy" sourceRef="Gateway_09ftulc" targetRef="Activity_1scob0v">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=finalAmount &gt;= 1000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:task id="Activity_0ot1onp" name="Proceed Directly">
      <bpmn:incoming>Flow_0qf5b9b</bpmn:incoming>
      <bpmn:outgoing>Flow_0npo7pa</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_1ezqypp" name="Send Order to Warehouse">
      <bpmn:incoming>Flow_0lfv08m</bpmn:incoming>
      <bpmn:incoming>Flow_0npo7pa</bpmn:incoming>
      <bpmn:outgoing>Flow_0y96xnt</bpmn:outgoing>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_0lfv08m" sourceRef="Activity_1scob0v" targetRef="Activity_1ezqypp" />
    <bpmn:sequenceFlow id="Flow_0npo7pa" sourceRef="Activity_0ot1onp" targetRef="Activity_1ezqypp" />
    <bpmn:sequenceFlow id="Flow_0qf5b9b" sourceRef="Gateway_09ftulc" targetRef="Activity_0ot1onp">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=finalAmount &lt; 1000</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:endEvent id="Event_0r6k1uy" name="Order Complete">
      <bpmn:incoming>Flow_0y96xnt</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_0y96xnt" sourceRef="Activity_1ezqypp" targetRef="Event_0r6k1uy" />
  </bpmn:process>
